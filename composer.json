{
  "name": "contributte/monolog",
  "description": "Monolog integration into Nette Framework",
  "keywords": [
    "nette",
    "monolog",
    "logging"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/contributte/monolog",
  "authors": [
    {
      "name": "Milan Felix Šulc",
      "homepage": "https://f3l1x.io"
    }
  ],
  "require": {
    "php": ">=8.2",
    "contributte/di": "^0.5.3",
    "monolog/monolog": "^2.0.0 || ^3.0.0",
    "nette/utils": "^3.0.0 || ^4.0.0"
  },
  "require-dev": {
    "contributte/phpstan": "^0.1.0",
    "contributte/qa": "^0.4.0",
    "contributte/tester": "^0.2.0",
    "tracy/tracy": "^2.9.4"
  },
  "autoload": {
    "psr-4": {
      "Contributte\\Monolog\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.6.x-dev"
    }
  }
}
